@page "/todos"
@attribute [Authorize]
@using panialera.Models
@using panialera.Services
@inject TodoService TodoService
@inject UnsavedGuard Guard
@inject IJSRuntime JS
@implements IDisposable

<div class="todos-container">
    <div class="todos-form-section" id="todos-form-top">
        <h4 class="fw-bold">@(editing == null ? "Nueva Tarea" : $"Editar Tarea #{editing.Id}")</h4>
        <TodoForm EditingTodo="editing"
                   ShowCancel="editing != null"
                   OnSaved="OnTodoSaved"
                   OnCancel="CancelEdit" />
    </div>

    <div class="todos-table-section">
        <div class="table-header">
            <h3 class="mb-0">Pendientes</h3>
            <div class="table-filters">
                <input type="text" class="form-control todo-filter"
                       placeholder="Buscar por título, descripción o cliente..."
                       @bind="searchTerm" @bind:event="oninput" />
                <select class="form-select sort-select" @bind="sortBy">
                    <option value="@SortBy.Date">Ordenar por fecha</option>
                    <option value="@SortBy.Priority">Ordenar por prioridad</option>
                </select>
                <div class="form-check hide-check">
                    <input class="form-check-input" type="checkbox" id="hide-completed" @bind="hideCompleted" />
                    <label class="form-check-label" for="hide-completed">Ocultar completadas</label>
                </div>
            </div>
        </div>

        @if (todos.Count == 0)
        {
            <p class="text-muted">No hay tareas cargadas.</p>
        }
        else if (Visible.Count == 0)
        {
            <p class="text-muted">No hay tareas que coincidan con los filtros.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover zebra-striped">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Fecha</th>
                            <th>Título</th>
                            <th>Descripción</th>
                            <th>Prioridad</th>
                            <th>Cliente</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Visible)
                        {
                            <tr class="@($"{(t.Completed ? "todo-completed" : "")} {(editing?.Id == t.Id ? "editing-row" : "")}".Trim())"
                                @ondblclick="() => EditTodo(t)" title="Doble clic para editar">
                                <td>@t.Id</td>
                                <td>@t.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>@t.Title</td>
                                <td class="todo-desc">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                                <td>
                                    <span class="badge @PriorityClass(t.Priority)">@t.Priority.DisplayName()</span>
                                </td>
                                <td>@(t.Customer?.Name ?? "—")</td>
                                <td @ondblclick:stopPropagation="true">
                                    <div class="action-buttons">
                                        @if (!t.Completed)
                                        {
                                            <button type="button" class="btn btn-sm btn-success action-btn"
                                                    title="Dar por completado" @onclick="() => SetCompleted(t, true)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l1.717 1.717 3.427-4.093a.3.3 0 0 1 .04-.06z" />
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary action-btn"
                                                    title="Reabrir" @onclick="() => SetCompleted(t, false)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
                                                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
                                                </svg>
                                            </button>
                                        }
                                        <EditButton OnClick="() => EditTodo(t)" />
                                        <DeleteButton OnClick="() => DeleteTodo(t)" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<TodoItem> todos = new();
    private TodoItem? editing;
    private string searchTerm = string.Empty;
    private SortBy sortBy = SortBy.Date;
    private bool hideCompleted = false;

    private enum SortBy { Date, Priority }

    private List<TodoItem> Visible
    {
        get
        {
            IEnumerable<TodoItem> q = todos;

            if (!string.IsNullOrWhiteSpace(searchTerm))
                q = q.Where(t =>
                    t.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (t.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (t.Customer?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

            if (hideCompleted)
                q = q.Where(t => !t.Completed);

            // Completed ones always go last; within each group, by the chosen order.
            q = sortBy == SortBy.Priority
                ? q.OrderBy(t => t.Completed).ThenBy(t => t.Priority).ThenByDescending(t => t.CreatedAt)
                : q.OrderBy(t => t.Completed).ThenByDescending(t => t.CreatedAt);

            return q.ToList();
        }
    }

    private static string PriorityClass(Priority p) => p switch
    {
        Priority.High => "bg-danger",
        Priority.Medium => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    protected override async Task OnInitializedAsync()
    {
        TodoService.Changed += OnTodosChanged;
        await LoadTodos();
    }

    // A change made from the sticky note shows here at once.
    private void OnTodosChanged() => _ = InvokeAsync(async () =>
    {
        await LoadTodos();
        StateHasChanged();
    });

    public void Dispose() => TodoService.Changed -= OnTodosChanged;

    private async Task LoadTodos()
    {
        todos = await TodoService.GetAllAsync();
    }

    private async Task OnTodoSaved()
    {
        editing = null;
        await LoadTodos();
    }

    private async Task EditTodo(TodoItem t)
    {
        if (!await Guard.TryLeaveAsync())
            return;

        editing = t;
        await JS.InvokeVoidAsync("scrollToTop");
    }

    private void CancelEdit()
    {
        editing = null;
    }

    private async Task SetCompleted(TodoItem t, bool completed)
    {
        await TodoService.SetCompletedAsync(t.Id, completed);
        await LoadTodos();
    }

    private async Task DeleteTodo(TodoItem t)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la tarea '{t.Title}'?"))
            return;

        await TodoService.DeleteAsync(t.Id);
        if (editing?.Id == t.Id)
            editing = null;
        await LoadTodos();
    }
}
