@using panialera.Models
@using panialera.Services
@inject TodoService TodoService
@inject UnsavedGuard Guard
@implements IDisposable

<div class="todo-form">
    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label">Título *</label>
            <input type="text" class="form-control" @bind="data.Title" @bind:event="oninput" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Prioridad</label>
            <select class="form-select" @bind="data.Priority">
                <option value="@Priority.High">Alta</option>
                <option value="@Priority.Medium">Media</option>
                <option value="@Priority.Low">Baja</option>
            </select>
        </div>
        <div class="col-md-12">
            <label class="form-label">Descripción</label>
            <textarea class="form-control" rows="3" @bind="data.Description" @bind:event="oninput"></textarea>
        </div>
        <div class="col-md-12">
            <label class="form-label">Cliente (opcional)</label>
            <CustomerSelector @bind-Selected="selectedCustomer" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger py-2 mt-3 mb-0" role="alert">@error</div>
    }

    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-success" @onclick="TrySaveAsync" disabled="@(!IsDirty)">
            @(IsEditing ? "Guardar" : "Agregar tarea")
        </button>
        @if (ShowCancel)
        {
            <button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
        }
    </div>
</div>

@code {
    [Parameter]
    public TodoItem? EditingTodo { get; set; }

    [Parameter]
    public bool ShowCancel { get; set; } = true;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private TodoItem data = new();
    private Customer? selectedCustomer;
    private string error = string.Empty;
    private IDisposable? guardReg;

    private TodoItem _initial = new();
    private Customer? _initialCustomer;

    private bool IsEditing => EditingTodo is { Id: > 0 };

    public bool IsDirty =>
        (data.Title ?? "") != (_initial.Title ?? "")
        || (data.Description ?? "") != (_initial.Description ?? "")
        || data.Priority != _initial.Priority
        || selectedCustomer?.Id != _initialCustomer?.Id;

    protected override void OnInitialized()
    {
        guardReg = Guard.Register(() => IsDirty, TrySaveAsync, Reset);
    }

    private TodoItem? _loadedFor;

    protected override void OnParametersSet()
    {
        // Only re-initialize when the item to edit changes (not on every re-render).
        if (ReferenceEquals(EditingTodo, _loadedFor))
            return;
        _loadedFor = EditingTodo;

        if (IsEditing)
        {
            data = Clone(EditingTodo!);
            selectedCustomer = EditingTodo!.Customer;
        }
        else
        {
            data = new TodoItem();
            selectedCustomer = null;
        }
        Snapshot();
    }

    private static TodoItem Clone(TodoItem t) => new()
    {
        Id = t.Id,
        Title = t.Title,
        Description = t.Description,
        Priority = t.Priority,
        Completed = t.Completed,
        CompletedAt = t.CompletedAt,
        CreatedAt = t.CreatedAt,
        CustomerId = t.CustomerId
    };

    private void Snapshot()
    {
        _initial = Clone(data);
        _initialCustomer = selectedCustomer;
    }

    private void Reset()
    {
        data = Clone(_initial);
        selectedCustomer = _initialCustomer;
        error = string.Empty;
        StateHasChanged();
    }

    public async Task<bool> TrySaveAsync()
    {
        error = string.Empty;
        data.CustomerId = selectedCustomer?.Id;

        if (IsEditing)
        {
            var (ok, err) = await TodoService.UpdateAsync(data);
            if (!ok) { error = err ?? "No se pudo guardar."; StateHasChanged(); return false; }
            Snapshot();
        }
        else
        {
            var (ok, err) = await TodoService.AddAsync(data);
            if (!ok) { error = err ?? "No se pudo crear."; StateHasChanged(); return false; }
            data = new TodoItem();
            selectedCustomer = null;
            Snapshot();
        }

        await OnSaved.InvokeAsync();
        return true;
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    public void Dispose() => guardReg?.Dispose();
}
